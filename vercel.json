{
  "redirects": [
    {
      "source": "/creator-portal",
      "destination": "https://www.travelvrse.com/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(creator-portal|barcelona|ignore-me|notrack|demo|demo/.*|vibe|vibe/.*|vibe-radar|mobile|simulator|live-mobile|presenter|demo-hub|play/mobile-demo)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/play/:path*",
      "destination": "https://ted-lasso-vibe-challenge.vercel.app/play/:path*"
    },
    {
      "source": "/v/:path*",
      "destination": "https://ted-lasso-vibe-challenge.vercel.app/v/:path*"
    },
    {
      "source": "/vibe/:path*",
      "destination": "https://ted-lasso-vibe-challenge.vercel.app/vibe/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://ted-lasso-vibe-challenge.vercel.app/assets/:path*"
    },
    {
      "source": "/models/:path*",
      "destination": "https://ted-lasso-vibe-challenge.vercel.app/models/:path*"
    },
    {
      "source": "/audio/:path*",
      "destination": "https://ted-lasso-vibe-challenge.vercel.app/audio/:path*"
    },
    {
      "source": "/textures/:path*",
      "destination": "https://ted-lasso-vibe-challenge.vercel.app/textures/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://ted-lasso-vibe-challenge.vercel.app/images/:path*"
    },
    {
      "source": "/config/:path*",
      "destination": "https://ted-lasso-vibe-challenge.vercel.app/config/:path*"
    },
    {
      "source": "/destinations/london/south-bank",
      "destination": "/destinations/london/south-bank/index.html"
    },
    {
      "source": "/compare/sea-containers-vs-bankside-hotel",
      "destination": "/compare/sea-containers-vs-bankside-hotel/index.html"
    },
    {
      "source": "/scouts/alex-hurd",
      "destination": "/scouts/alex-hurd/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
